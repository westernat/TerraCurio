{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "terra_curio:bubble",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "terra_curio:bubble"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 10,
				"max_particles": 30
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-0.12, 0.12)", "math.random(-0.15, 0.05)", "math.random(-0.12, 0.12)"]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size=0.1+(variable.particle_random_1)*0.12;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.0, 2.0)"
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:water"],
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": "math.random(0.1, 0.3)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.35, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": ["v.particle_random_3>0.5?0:8", "v.particle_random_4>0.5?0:8"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.15
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.12": "#BFFFFFFF",
						"0.7": "#BFFFFFFF",
						"1.0": "#00FFFFFF"
					}
				}
			},
			"minecraft:particle_appearance_lighting": {}
		}
	}
}
