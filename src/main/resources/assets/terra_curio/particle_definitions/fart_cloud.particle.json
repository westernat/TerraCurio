{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "terra_curio:fart_cloud",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "terra_curio:small_cloud"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 16
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"half_dimensions": [0.25, 0.3, 0.25],
				"offset": [0, -0.5, 0],
				"direction": ["math.random(-0.4, 0.4)", "math.random(0.2, 0.7)", "math.random(-0.4, 0.4)"]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size=0.28+(variable.particle_age/variable.particle_lifetime)*0.35;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.7, 1.2)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": "math.random(0.2, 0.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.4, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 64,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 8,
						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00A6E080",
						"0.15": "#E6A6E080",
						"0.75": "#E6A6E080",
						"1.0": "#00A6E080"
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_lighting": {}
		}
	}
}
