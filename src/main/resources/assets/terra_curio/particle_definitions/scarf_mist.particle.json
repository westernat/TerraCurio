{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "terra_curio:scarf_mist",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "terra_curio:small_cloud"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 6,
				"max_particles": 16
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_entity_aabb": {
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size=0.25+(variable.particle_age/variable.particle_lifetime)*0.3;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.5, 2.5)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)",
				"rotation_rate": "math.random(-15, 15)"
			},
			"minecraft:particle_initial_speed": "math.random(0.05, 0.15)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.12, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 64,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 4,
						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#007A54AD",
						"0.2": "#737A54AD",
						"0.75": "#737A54AD",
						"1.0": "#007A54AD"
					}
				}
			},
			"minecraft:particle_appearance_lighting": {}
		}
	}
}
