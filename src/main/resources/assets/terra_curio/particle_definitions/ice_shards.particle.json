{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "terra_curio:ice_shards",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "terra_curio:crystal"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 10,
				"max_particles": 24
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-0.35, 0.35)", "math.random(0, 0.4)", "math.random(-0.35, 0.35)"]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "variable.size=0.09+(variable.particle_random_1)*0.05;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.4, 0.8)"
			},
			"minecraft:particle_initial_spin": {
